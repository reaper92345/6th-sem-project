# Copy this file to .env before running Docker Compose.
# Generate your own strong secrets for any non-local environment.
POSTGRES_PASSWORD=EquipShare-Local-Database-Password-Change-Me
JWT_SECRET=local-development-secret-change-this-to-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
